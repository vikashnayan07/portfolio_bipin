{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/files/favicon-bk-v2.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!static|api|favicon|files|logo|manifest|robots|asset-manifest).*)",
      "destination": "/index.html"
    }
  ]
}
